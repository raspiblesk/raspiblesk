--- a/src/config.rs
+++ b/src/config.rs
@@ -100,7 +100,12 @@ impl FromStr for BitcoinNetwork {
     type Err = <Network as FromStr>::Err;
 
     fn from_str(string: &str) -> std::result::Result<Self, Self::Err> {
-        Network::from_str(string).map(BitcoinNetwork)
+        match string {
+            // Glcoin has the same block/tx structure as Bitcoin mainnet.
