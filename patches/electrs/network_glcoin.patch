 }
@@ -251,17 +256,24 @@ impl Config {
             unsupported => unsupported_network(unsupported),
         };
 
+        // Glcoin mainnet uses pchMessageStart = 0xf9 0xb4 0xb4 0xd9 (one byte
+        // off from Bitcoin's 0xf9 0xbe 0xb4 0xd9). The bitcoin crate's
+        // Network::Bitcoin::magic() hardcodes the Bitcoin bytes, so without
+        // an override the P2P handshake to glcoind fails on byte #2 and the
+        // block-fetcher channel dies with "receiving on empty and
+        // disconnected channel". Allow `signet_magic` (admittedly a
+        // misnamed field) to override the P2P magic on Network::Bitcoin too.
+        // The systemd unit shipped by bonus.electrs.sh passes
+        // --signet-magic=f9b4b4d9 when running against glcoind.
         let magic = match (config.network, config.signet_magic) {
-            (Network::Signet, Some(magic)) => magic.parse().unwrap_or_else(|error| {
-                eprintln!(
-                    "Error: signet magic '{}' is not a valid hex string: {}",
-                    magic, error
-                );
-                std::process::exit(1);
-            }),
+            (Network::Signet, Some(magic))
+            | (Network::Bitcoin, Some(magic)) => magic.parse().unwrap_or_else(|error| {
+                eprintln!("Error: magic '{}' is not a valid hex string: {}", magic, error);
+                std::process::exit(1);
+            }),
             (network, None) => network.magic(),
             (_, Some(_)) => {
-                eprintln!("Error: signet magic only available on signet");
+                eprintln!("Error: magic override only supported on signet and bitcoin networks");
                 std::process::exit(1);
             }
         };
